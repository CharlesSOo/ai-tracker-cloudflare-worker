{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-tracker-cloudflare-worker",
  "main": "src/collector.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "AI_TRACKER_URL": "https://ai-tracker.smol.capital",
    "TRACKED_HOST": "your-site.example"
  },
  "secrets": {
    "required": [
      "INGEST_TOKEN"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
